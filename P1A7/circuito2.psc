Algoritmo circuito2
	// Alejandro Bacelis Eguiza
	Definir p,q como logico
	
	p= Verdadero
	q = Verdadero
	Escribir p, "-",q,"-",p o q,"-", no (p o q), "-", no (p o q) y (p o q)
	p= Verdadero
	q = falso
	Escribir p, "-",q,"-",p o q,"-", no (p o q), "-", no (p o q) y (p o q)
	p= falso
	q = Verdadero
	Escribir p, "-",q,"-",p o q,"-", no (p o q), "-", no (p o q) y (p o q)
	p= falso
	q = falso
	Escribir p, "-",q,"-",p o q,"-", no (p o q), "-", no (p o q) y (p o q)
	
	
FinAlgoritmo
